# =============================================================================
# Production environment — prod database + cloud LLM providers
# =============================================================================
# Used by:
#   make docker-up-local-prod         Local containers -> PROD DB + cloud LLMs
#   make docker-up-local-prod-acr-be  Prod backend image from ACR + local frontend
#   make docker-build-prod            Build & push images to ACR
#   make docker-deploy-prod           Deploy to Azure Container Apps
#
# Copy to .env.production and fill in the real secrets:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production. All keys here reach REAL production services —
# the DATABASE_URL below points at the live database.
#
# Prerequisites for the local-prod modes:
#   1. Your IP allowed on the Azure PostgreSQL firewall:  make az-pg-add-ip
#   2. For the ACR backend variant:                       az acr login --name $ACR_NAME
# =============================================================================

# --- Azure resources ----------------------------------------------------------
ACR_NAME=bibleappacrmb0172

# --- Database (Azure PostgreSQL Flexible Server) -------------------------------
# sslmode=require is mandatory for Azure PG; the API translates it for asyncpg.
DATABASE_URL=postgresql://<user>:<password>@bible-app-db-mb0172.postgres.database.azure.com:5432/bibledb?sslmode=require

# --- LLM (OpenRouter) ----------------------------------------------------------
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct
OPENROUTER_ALLOW_FALLBACKS=true

# --- Embeddings (Azure OpenAI) --------------------------------------------------
EMBEDDING_PROVIDER=azure_openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE_ME
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Frontend -------------------------------------------------------------------
# For local-prod runs the frontend talks to the local API:
NEXT_PUBLIC_API_URL=http://localhost:8000
# For ACR image builds (make docker-build-prod) point it at the prod backend:
# NEXT_PUBLIC_API_URL=https://api.voxquieta.org

# --- Optional providers / integrations -------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# SMTP2GO_API_KEY=api-...
