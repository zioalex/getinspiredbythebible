## Android-specific gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik runtime
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (contains SDK path — machine-specific)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# Android Studio / IntelliJ IDEA
*.iml
.idea/
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches

# Keystore files (NEVER commit these)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# MacOS metadata
.DS_Store

# Gradle wrapper jar (binary — regenerate with: gradle wrapper --gradle-version 8.9)
gradle/wrapper/gradle-wrapper.jar
