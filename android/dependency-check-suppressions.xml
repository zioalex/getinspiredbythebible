<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!--
    Suppressions for known false positives in OWASP Dependency Check.
    Review the HTML report artifact after each OWASP scan run and add
    suppressions here for any confirmed false positives.

    Format:
      <suppress>
        <notes>CVE-XXXX-XXXXX: False positive - this library is not affected because...</notes>
        <cve>CVE-XXXX-XXXXX</cve>
      </suppress>
  -->

  <!--
    To add a suppression after reviewing the HTML report:

      <suppress>
        <notes>CVE-XXXX-XXXXX: Confirmed false positive.
          [Library] is not affected because [reason].
          See: [upstream issue/advisory link]
        </notes>
        <cve>CVE-XXXX-XXXXX</cve>
      </suppress>
  -->
</suppressions>
