<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme — Compose handles most theming; this is needed for the window/activity level. -->
    <style name="Theme.VoxQuieta" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Splash screen theme — used only during the launch window before MainActivity draws its
      first frame.  Extends the AndroidX SplashScreen theme so the compat library can read
      the windowSplashScreen* attributes on API < 31.

      Colours:
        background  #2A1608  — dark warm brown (matches new brand)
        icon        @drawable/ic_splash_icon  — open bible with rays, centred
        iconBg      #2A1608  — same as background so the icon blends in (API 31+)
    -->
    <style name="Theme.VoxQuieta.Splash" parent="Theme.SplashScreen">
        <!-- Background colour of the splash window -->
        <item name="windowSplashScreenBackground">#2A1608</item>

        <!-- Animated / static icon shown in the centre of the screen -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>

        <!-- Duration hint for the splash animation (ms). setKeepOnScreenCondition in
             MainActivity may dismiss earlier if the backend responds fast, or hold longer
             on a cold start. 700 ms gives a deliberate, perceptible beat at typical speed. -->
        <item name="windowSplashScreenAnimationDuration">700</item>

        <!--
          Brand icon background colour (API 31+).  Setting it to the same dark brown as
          the window background makes the circular icon container invisible, so the art
          appears to float directly on the dark backdrop.
        -->
        <item name="windowSplashScreenIconBackgroundColor">#2A1608</item>

        <!-- Theme to switch to after the splash screen exits -->
        <item name="postSplashScreenTheme">@style/Theme.VoxQuieta</item>
    </style>
</resources>
