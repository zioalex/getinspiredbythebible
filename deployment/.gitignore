# Terraform files
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable definitions
# terraform.tfvars is committed (contains non-sensitive config)
# terraform.tfvars.secrets is gitignored (contains secrets)
terraform.tfvars.secrets
*.auto.tfvars
!terraform.tfvars
!terraform.tfvars.example
!terraform.tfvars.secrets.example

# Backend configuration (contains storage account name)
backend.hcl
!backend.hcl.example

# SSL Certificates and Private Keys (NEVER commit these!)
*.pfx
*.pem
*.key
*.crt
*.p12
