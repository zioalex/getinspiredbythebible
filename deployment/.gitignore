# Terraform files
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive variable definitions
*.tfvars
!terraform.tfvars.example

# Backend configuration (contains storage account name)
backend.hcl
!backend.hcl.example

# SSL Certificates and Private Keys (NEVER commit these!)
*.pfx
*.pem
*.key
*.crt
*.p12
