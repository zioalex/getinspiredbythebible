# =============================================================================
# Terraform SECRETS Template - Copy to terraform.tfvars.secrets
# =============================================================================
# This file contains sensitive credentials. It is gitignored.
# Copy this file to terraform.tfvars.secrets and fill in your actual values.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Credentials
# -----------------------------------------------------------------------------

# Password requirements: min 8 chars, uppercase, lowercase, number
db_admin_password = "YourSecurePassword123!" # pragma: allowlist secret

# -----------------------------------------------------------------------------
# LLM API Keys
# -----------------------------------------------------------------------------

# OpenRouter API key (get from https://openrouter.ai/keys)
openrouter_api_key = "sk-or-v1-your-key-here" # pragma: allowlist secret

# OpenAI API key (optional) for content-safety OpenAI Moderation, the ml_only
# failover when Llama Guard is down (BITB-272/288). Only gates whether the
# Container App secret exists; the real value is set out-of-band by
# azure-deploy.yml (repo secret OPENAI_API_KEY). Confirm OpenAI data retention
# is acceptable before enabling. Empty = disabled.
# openai_api_key = "sk-..." # pragma: allowlist secret

# Claude API key (optional, if using Claude provider)
# claude_api_key = "sk-ant-api03-..." # pragma: allowlist secret
