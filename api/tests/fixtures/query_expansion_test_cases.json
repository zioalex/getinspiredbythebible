      "language": "en",
      "expected_themes": ["peace", "trust", "worry", "tomorrow", "anxiety", "God's plan"],
      "bible_references": ["Matthew 6:34", "Philippians 4:6-7", "Proverbs 3:5-6"]
    },
    {
