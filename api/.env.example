# Bible Chat API Configuration
# Copy this file to .env and customize

# ===========================================
# LLM CONFIGURATION
# ===========================================

# Provider: ollama, claude, openrouter, or openai
LLM_PROVIDER=ollama

# Model name (depends on provider)
# Ollama: llama3:8b, mistral:7b, phi3:medium
# Claude: claude-sonnet-4-20250514
# OpenRouter: meta-llama/llama-3.3-70b-instruct:free, google/gemma-2-9b-it:free
LLM_MODEL=llama3:8b

# Generation parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ===========================================
# OLLAMA CONFIGURATION (for local LLM)
# ===========================================

OLLAMA_HOST=http://localhost:11434

# ===========================================
# EMBEDDING CONFIGURATION
# ===========================================

# Provider: ollama, openrouter, or openai
# Note: OpenRouter doesn't support embeddings, use ollama for embeddings
EMBEDDING_PROVIDER=ollama

# Model for generating embeddings
# mxbai-embed-large: Multilingual model (100+ languages, 1024 dim, ~670MB)
# nomic-embed-text: English-only (768 dim, lighter)
EMBEDDING_MODEL=mxbai-embed-large

# Vector dimensions (must match model output)
# mxbai-embed-large: 1024
# nomic-embed-text: 768
EMBEDDING_DIMENSIONS=1024

# ===========================================
# DATABASE
# ===========================================

DATABASE_URL=postgresql://bible:bible123@localhost:5432/bibledb  # pragma: allowlist secret

# ===========================================
# EXTERNAL API KEYS (optional)
# ===========================================

# For Claude provider
# ANTHROPIC_API_KEY=sk-ant-...

# For OpenRouter provider (free models available)
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# For OpenAI provider
# OPENAI_API_KEY=sk-...

# ===========================================
# AZURE OPENAI (for Azure deployment)
# ===========================================
# To use Azure OpenAI for embeddings:
# 1. Set EMBEDDING_PROVIDER=azure_openai
# 2. Set EMBEDDING_DIMENSIONS=1536 (for text-embedding-3-small)
# 3. Configure the Azure OpenAI settings below

# Azure OpenAI resource endpoint
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API key
# AZURE_OPENAI_API_KEY=your-api-key

# Deployment name for embedding model
# AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ===========================================
# APPLICATION
# ===========================================

DEBUG=true
APP_NAME="Bible Inspiration Chat"

# Chat settings
MAX_CONTEXT_VERSES=5
MAX_CONVERSATION_HISTORY=10

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===========================================
# PERFORMANCE MONITORING
# ===========================================
# Log database queries slower than this threshold (milliseconds)
# SLOW_QUERY_THRESHOLD_MS=100

# ===========================================
# EMAIL NOTIFICATIONS (SMTP2GO HTTP API)
# ===========================================
# For contact form and feedback notifications
# Uses SMTP2GO's HTTP API with API key authentication

# Set to true to enable email notifications
SMTP2GO_ENABLED=false

# SMTP2GO API key (get from smtp2go.com dashboard > Settings > API Keys)
# SMTP2GO_API_KEY=api-xxxxxxxxxxxxxxxx

# Sender information (must be verified in SMTP2GO)
SMTP2GO_SENDER_EMAIL=noreply@voxquieta.org
SMTP2GO_SENDER_NAME=Bible Inspiration

# Where to send notifications (contact form submissions, negative feedback)
CONTACT_NOTIFICATION_EMAIL=contact@voxquieta.org

# ===========================================
# CLOUDFLARE TURNSTILE (Bot Protection)
# ===========================================
# Invisible CAPTCHA alternative for bot protection
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile

# Enable Turnstile verification (set to true in production)
TURNSTILE_ENABLED=false

# Server-side secret key (never expose this)
# TURNSTILE_SECRET_KEY=0x...

# Client-side site key (safe to expose, sent to frontend)
# TURNSTILE_SITE_KEY=0x...

# Paths to skip verification (comma-separated)
TURNSTILE_SKIP_PATHS=/health,/docs,/openapi.json,/config,/

# Test keys for development:
# Site key (always passes, invisible): 1x00000000000000000000AA
# Secret key (always passes): 1x0000000000000000000000000000000AA
# Secret key (always fails): 2x0000000000000000000000000000000AA

# ===========================================
# CONTENT SAFETY (Optional - Multi-Language Harm Detection)
# ===========================================
# Hybrid keyword + Azure Content Safety filter
# Distinguishes help-seeking (allow) from harmful intent (block)
# Default: disabled (keyword_only mode when enabled)

# Master switch - set to true to enable content safety filtering
CONTENT_SAFETY_ENABLED=false

# Mode: keyword_only | hybrid | ml_only
# keyword_only: Fast local filter only (no API calls, no cost)
# hybrid: Keyword first, then Azure for ambiguous cases (recommended)
# ml_only: Azure API only (not recommended - no fallback)
CONTENT_SAFETY_MODE=keyword_only

# Azure Content Safety (optional - required for hybrid/ml_only modes)
# Free tier: 5,000 text records/month
# Get at: https://portal.azure.com > Create Resource > Content Safety
AZURE_CONTENT_SAFETY_ENABLED=false
# AZURE_CONTENT_SAFETY_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
# AZURE_CONTENT_SAFETY_KEY=your-api-key-here
# AZURE_CONTENT_SAFETY_THRESHOLD=4  # 0-6, block >= threshold (default: 4)
