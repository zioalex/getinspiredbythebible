# =============================================================================
# Side-by-side dev stack — runs NEXT TO an existing prod/local stack
# =============================================================================
# Used by:  make docker-up-dev    (docker-compose.dev.yml, project getinspired-dev)
#
# Ports are shifted so nothing collides with the main stack:
#   Frontend 3001, API 8001, Postgres 5433, Ollama 11435
#
# Copy to .env.dev (make docker-up-dev does this automatically on first run):
#   cp .env.dev.example .env.dev
# =============================================================================

# --- LLM ---------------------------------------------------------------------
# Default: local Ollama. Set to openrouter to test cloud chat while keeping
# local embeddings (then OPENROUTER_API_KEY is required).
LLM_PROVIDER=ollama
LLM_MODEL=mistral:7b

# Model Ollama itself should pull/serve (kept separate from LLM_MODEL so an
# OpenRouter slug never leaks into an `ollama pull`).
OLLAMA_LLM_MODEL=mistral:7b

# --- Embeddings (local Ollama) -----------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=mxbai-embed-large

# --- Optional: OpenRouter chat -----------------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_ALLOW_FALLBACKS=true
